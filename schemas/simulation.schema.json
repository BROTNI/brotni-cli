{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.brotni.io/v1/simulation",
  "title": "Simulation",
  "description": "A Brotni simulation spec that wires a recipe and context together for execution.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "Schema version, e.g. brotni.io/v1"
    },
    "kind": {
      "type": "string",
      "const": "Simulation",
      "description": "Must be 'Simulation'"
    },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "recipeRef": {
          "type": "string",
          "description": "Reference to a Recipe resource name or file path"
        },
        "contextRef": {
          "type": "string",
          "description": "Reference to a Context resource name or file path"
        },
        "timeout": {
          "type": "string",
          "description": "Maximum simulation duration, e.g. '30m' or '2h'"
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of retry attempts on failure"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Static parameter overrides for the simulation"
        }
      }
    }
  },
  "additionalProperties": false
}
